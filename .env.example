# BilSec Brain — canlı yapay zekâ için Anthropic Claude API anahtarı.
# Bu dosyayı ".env" olarak kopyalayın ve anahtarınızı girin.
# Anahtar YOKSA uygulama yine çalışır; yapay zekâ özellikleri gömülü örnek (fallback) çıktı gösterir.

ANTHROPIC_API_KEY=

# İsteğe bağlı — kullanılacak model (varsayılan: claude-sonnet-5)
# CLAUDE_MODEL=claude-sonnet-5
