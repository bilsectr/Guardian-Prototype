# BilSec Brain — canlı yapay zekâ (LLM) yapılandırması.
# Bu dosyayı ".env" olarak kopyalayın ve değerleri girin.
# Değerler YOKSA uygulama yine çalışır; yapay zekâ özellikleri gömülü örnek (fallback) çıktı gösterir.

# LLM sağlayıcı API anahtarınız
AI_API_KEY=

# LLM mesaj uç noktası (tam URL)
AI_API_URL=

# Kullanılacak model kimliği
AI_MODEL=

# (İsteğe bağlı) Sağlayıcının istediği sürüm başlığı adı ve değeri
AI_API_VERSION_HEADER=
AI_API_VERSION=
